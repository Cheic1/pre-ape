# Copy to .env (never commit it). Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
# Host port for the app (default 7032, the one the cloudflared tunnel uses)
APP_PORT=7032
# Admin panel (/api/v1/admin): comma-separated emails, case-insensitive.
# Empty = no admin. The role is granted only here (no UI); re-login to see it.
ADMIN_EMAILS=
