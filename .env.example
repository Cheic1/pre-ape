# Copy to .env (never commit it). Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
# Host port for the app (default 7032, the one the cloudflared tunnel uses)
APP_PORT=7032
# Admin panel (/api/v1/admin): comma-separated emails, case-insensitive.
# Empty = no admin. The role is granted only here (no UI); re-login to see it.
ADMIN_EMAILS=
# Cifratura dei documenti catastali (AES-256-GCM): base64 di 32 byte casuali.
# Obbligatoria in produzione. Generala con:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# CONSERVANE UNA COPIA FUORI DAL SERVER: se la perdi, i documenti sono irrecuperabili.
DOCUMENTS_ENCRYPTION_KEY=
# Documenti legali (privacy, termini, DPA): dati del gestore che compaiono nei
# testi (backend/app/legal/*.md). Vuoti = "[da completare: …]" + banner bozza.
# LEGAL_TITOLARE_NOME="Mario Rossi"            # nome o ragione sociale
# LEGAL_TITOLARE_INDIRIZZO="Via Roma 1, 20100 Milano (MI)"
# LEGAL_TITOLARE_PIVA_CF="P.IVA 01234567890"
# LEGAL_TITOLARE_EMAIL_PRIVACY="privacy@example.com"
# LEGAL_SERVER_UBICAZIONE="Italia"
# LEGAL_FORO_COMPETENTE="Milano"
# LEGAL_DATA_EFFICACIA="19/10/2026"

# --- Abbonamenti (backend/app/core/billing.py) -----------------------------
# Spento = tutti illimitati (come oggi). Acceso: prova gratuita di TRIAL_DAYS
# giorni e TRIAL_MAX_SURVEYS sopralluoghi, poi serve un abbonamento per creare
# sopralluoghi ed esportare in CENED (i dati restano sempre consultabili).
# Gli abbonamenti si attivano a mano dal pannello admin (bonifico) o con Stripe.
# BILLING_ENABLED=true
# TRIAL_DAYS=30
# TRIAL_MAX_SURVEYS=5
# Stripe (facoltativo): chiave segreta, segreto del webhook
# (endpoint https://<dominio>/api/v1/billing/webhook, eventi
# checkout.session.completed e customer.subscription.*) e id dei prezzi.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# PUBLIC_BASE_URL=https://preape.cheic2.it

# --- Accesso al Catasto via fornitore a pagamento ---------------------------
# Ogni richiesta costa (visura ~1,90 EUR, elaborato planimetrico ~6,90 EUR + IVA)
# e viene addebitata sul credito del fornitore. Prima prova in sandbox.
# CATASTO_PROVIDER=openapi
# CATASTO_OPENAPI_TOKEN=
# CATASTO_OPENAPI_SANDBOX=true
# CATASTO_MONTHLY_LIMIT=20
